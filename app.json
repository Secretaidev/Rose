{
  "name": "Rose Bot",
  "description": "A powerful Telegram group management bot clone",
  "repository": "https://github.com/yourusername/rose-bot",
  "logo": "https://telegra.ph/file/5f1fac7d55e4ae5b0b55f.jpg",
  "keywords": ["telegram", "bot", "group", "management", "moderation"],
  "env": {
    "TOKEN": {
      "description": "Your bot token from @BotFather",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram user ID",
      "required": true
    },
    "OWNER_USERNAME": {
      "description": "Your Telegram username",
      "required": false
    },
    "DATABASE_URL": {
      "description": "Database URL (PostgreSQL/SQLite)",
      "value": "sqlite:///rose_bot.db",
      "required": false
    },
    "MONGODB_URL": {
      "description": "MongoDB Atlas URL (alias for DATABASE_URL)",
      "required": false
    },
    "ENV": {
      "description": "Set to ANYTHING to use env variables",
      "value": "ANYTHING",
      "required": true
    },
    "WEBHOOK": {
      "description": "Enable webhook mode",
      "value": "False",
      "required": false
    },
    "URL": {
      "description": "Webhook URL (if using webhook)",
      "required": false
    },
    "WORKERS": {
      "description": "Number of worker threads",
      "value": "8",
      "required": false
    },
    "SUDO_USERS": {
      "description": "Space-separated list of sudo user IDs",
      "required": false
    },
    "SUPPORT_USERS": {
      "description": "Space-separated list of support user IDs",
      "required": false
    },
    "WHITELIST_USERS": {
      "description": "Space-separated list of whitelisted user IDs",
      "required": false
    },
    "MESSAGE_DUMP": {
      "description": "Chat ID for logging actions",
      "required": false
    },
    "LOGGER_ID": {
      "description": "Private channel ID for detailed logs",
      "required": false
    },
    "DEL_CMDS": {
      "description": "Delete commands from non-admins",
      "value": "False",
      "required": false
    },
    "STRICT_GBAN": {
      "description": "Strict global ban enforcement",
      "value": "True",
      "required": false
    },
    "ALLOW_EXCL": {
      "description": "Allow exclamation command prefix",
      "value": "True",
      "required": false
    },
    "BAN_STICKER": {
      "description": "Sticker file_id for ban messages",
      "value": "CAADAgADOwADPPEcAXkko5EB3YmgAg",
      "required": false
    },
    "FED_ADMIN_TXT": {
      "description": "Federation admin display name",
      "value": "Rose Bot",
      "required": false
    },
    "DEFAULT_LANG": {
      "description": "Default language code",
      "value": "en",
      "required": false
    },
    "LOAD": {
      "description": "Space-separated module names to load",
      "required": false
    },
    "NO_LOAD": {
      "description": "Space-separated module names to skip",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "addons": [
    {
      "plan": "heroku-postgresql:mini",
      "optional": true
    }
  ]
}
