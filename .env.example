# Rose Bot Configuration
# Copy this file to .env and fill in your values

# Required
TOKEN=your_bot_token_here
OWNER_ID=your_telegram_user_id
ENV=ANYTHING

# Optional
OWNER_USERNAME=your_username
DATABASE_URL=sqlite:///rose_bot.db
WEBHOOK=False
URL=https://your-app.herokuapp.com
PORT=8443
WORKERS=8

# Support Users (space-separated IDs)
SUDO_USERS=
SUPPORT_USERS=
WHITELIST_USERS=

# Features
DEL_CMDS=False
STRICT_GBAN=True
ALLOW_EXCL=True
MESSAGE_DUMP=

# Default Language
DEFAULT_LANG=en
