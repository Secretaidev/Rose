# Rose Bot Configuration
# Copy this file to .env and fill in your values

# Required
# TOKEN: get from @BotFather (example: 123456:ABCDEF...)
TOKEN=your_bot_token_here
# OWNER_ID: get from @userinfobot (example: 123456789)
OWNER_ID=your_telegram_user_id
# ENV: set to ANYTHING to use env vars
ENV=ANYTHING

# Optional
# OWNER_USERNAME: your Telegram username (example: your_username)
OWNER_USERNAME=your_username

# Database
# DATABASE_URL: SQLAlchemy DB URL (example: sqlite:///rose_bot.db or ******host/db)
DATABASE_URL=sqlite:///rose_bot.db
# MONGODB_URL: MongoDB Atlas connection string (example: ******cluster/db)
MONGODB_URL=

# Logging (private channel IDs)
# LOGGER_ID: private channel for detailed logs (add bot as admin, get ID via @userinfobot)
LOGGER_ID=
# MESSAGE_DUMP: moderation/action log channel (defaults to LOGGER_ID if set)
MESSAGE_DUMP=

# Webhook settings
WEBHOOK=False
URL=https://your-app.example.com
PORT=8443
CERT_PATH=

# Workers
WORKERS=8

# Support Users (space-separated IDs)
SUDO_USERS=
SUPPORT_USERS=
WHITELIST_USERS=

# Module loading (space-separated module names)
LOAD=
NO_LOAD=

# Features
DEL_CMDS=False
STRICT_GBAN=True
ALLOW_EXCL=True
# BAN_STICKER: sticker file_id used for ban messages
BAN_STICKER=CAADAgADOwADPPEcAXkko5EB3YmgAg
# FED_ADMIN_TXT: federation admin display name
FED_ADMIN_TXT=Rose Bot

# Default Language
DEFAULT_LANG=en
